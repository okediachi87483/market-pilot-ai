# Copy to .env and adjust as needed. Never commit the real .env file.
# See docs/security.md §1-2.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Ports (host-side; containers always listen on their default port) ---
API_PORT=8000
WEB_PORT=3000

# --- PostgreSQL ---
# POSTGRES_HOST is only used when running the API outside Docker Compose
# (Compose sets it to the "postgres" service name automatically).
# If 5432 is already bound by another local Postgres instance, change
# POSTGRES_PORT (e.g. 5433) — only the host-side port changes.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketpilot
POSTGRES_USER=marketpilot
POSTGRES_PASSWORD=marketpilot

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Frontend (consumed client-side; must be host-reachable, not a
# Docker service name) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI provider (architectural placeholder — see docs/ai-architecture.md)
# No key is required to run the Phase 2 foundation; ai-engine does not
# exist yet.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
AI_PROVIDER_API_KEY=

# --- Risk Engine (Phase 6, see docs/risk-engine.md) ---
# There is no paper-trading portfolio yet (Phase 7), so the Risk Engine
# evaluates every candidate against this clean, fully-funded, position-
# free simulated starting equity.
RISK_STARTING_EQUITY=100000
