# Copy to .env and adjust as needed. Never commit the real .env file.
# See docs/security.md §1-2.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Ports (host-side; containers always listen on their default port) ---
API_PORT=8000
WEB_PORT=3000

# --- PostgreSQL ---
# POSTGRES_HOST is only used when running the API outside Docker Compose
# (Compose sets it to the "postgres" service name automatically).
# If 5432 is already bound by another local Postgres instance, change
# POSTGRES_PORT (e.g. 5433) — only the host-side port changes.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketpilot
POSTGRES_USER=marketpilot
POSTGRES_PASSWORD=marketpilot

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Frontend (consumed client-side; must be host-reachable, not a
# Docker service name) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI Analyst (Phase 8, see docs/ai-analyst.md) ---
# No key is required to run the rest of the platform — an empty
# AI_PROVIDER_API_KEY makes GET /ai/status report "not configured" and
# every other pipeline stage (market data, signals, risk, paper trading)
# continues to work unaffected.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
AI_PROVIDER_API_KEY=

# Passed as max_tokens on every Claude call.
AI_ANALYST_MAX_OUTPUT_TOKENS=1024
# Request timeout (seconds) on the Claude client.
AI_ANALYST_TIMEOUT_SECONDS=30.0
# Repeated analysis requests for the same signal within this window
# return the existing analysis instead of generating a new one.
AI_ANALYST_COOLDOWN_MINUTES=15

# --- Risk Engine / Paper Trading (Phase 6/7, see docs/risk-engine.md
# and docs/paper-trading.md) ---
# The one simulated paper-trading account's starting cash and equity —
# read once, when the account row is first seeded by migration.
RISK_STARTING_EQUITY=100000

# Simulated trading fee applied to every paper fill's notional value.
# 0.001 = 10 basis points.
PAPER_TRADING_FEE_RATE=0.001
