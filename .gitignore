# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
next-env.d.ts

# --- Python / FastAPI ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Docker ---
*.pid

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# --- Claude Code session state (not project content) ---
.claude/

# --- Logs ---
*.log
logs/

# --- Build artifacts ---
dist/
build/
coverage/

# --- Design canvas seeded output (regenerated from the .dc.html sources
