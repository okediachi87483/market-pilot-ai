# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
next-env.d.ts

# --- Python / FastAPI ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Docker ---
*.pid

# --- Terraform ---
# State, saved plans, and real tfvars stay out of git — all three can
# carry secrets in plaintext (a saved plan embeds resource attribute
# values, e.g. a generated RDS password, exactly like state does). The
# dependency lock file is deliberately COMMITTED — it pins exact
# provider builds, the same role package-lock.json plays for npm.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
tfplan*
*.tfplan
crash.log
crash.*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# --- Claude Code session state (not project content) ---
.claude/

# --- Logs ---
*.log
logs/

# --- Build artifacts ---
dist/
build/
coverage/

# --- Design canvas seeded output (regenerated from the .dc.html sources
# via the design skill's seed-canvas.mjs; the source files are what's
# tracked, not the ~2.5MB bundled editor payload) ---
docs/design/**/*.html
!docs/**/*.dc.html
